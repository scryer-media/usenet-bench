# Real Usenet provider for an external chain stack (configs/chains/real-usenet.example.json).
# Copy to runs/.env (beside the chain config), fill it in, and chmod 600 it.
# Only the file's path is ever logged; the password is scrubbed from run evidence.
NNTP_HOST=news.example.net
# Implicit TLS. The external lane measures TLS only, validated against public roots.
NNTP_TLS=true
NNTP_PORT=563
NNTP_USERNAME=your-username
NNTP_PASSWORD=your-password
# Every client gets exactly this many connections; keep it within the account's limit.
NNTP_CONNECTIONS=20
